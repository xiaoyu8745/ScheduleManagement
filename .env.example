# ChronoFlow 主进程环境变量（复制为 .env 后生效；.env 已被 gitignore）
#
# MOCK_MODE=true  → 各能力返回 src/shared/mock.ts 的样例数据（演示/开发用）
# MOCK_MODE=false → 走真实实现（含云端消息整合的真实 API 调用）
#
# 优先级：shell 里显式设置的环境变量 > .env 文件（由 src/core/load-env.ts 加载）
MOCK_MODE=true

# ============ 云端消息整合（飞书） ============
# 仅在 MOCK_MODE=false 且使用「云端整合」功能时需要。
# 获取方式：飞书开放平台 https://open.feishu.cn → 创建企业自建应用 →
#   凭证与基础信息页可拿到 App ID / App Secret；应用需加入目标群并开通
#   im:message / im:chat 读取权限。
# FEISHU_APP_ID=cli_xxxx
# FEISHU_APP_SECRET=xxxx
